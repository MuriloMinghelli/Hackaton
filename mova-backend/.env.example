# Copie este arquivo para ".env" e preencha.

# Chave da API da Anthropic — obrigatória para a narrativa ser gerada por IA de verdade.
# Sem ela, o backend cai automaticamente para um texto-modelo (sem custo, sem IA).
ANTHROPIC_API_KEY=

# Opcional — troca o modelo usado para gerar a narrativa. Padrão: claude-opus-5.
# Pra um hackathon com muitas chamadas de teste, claude-haiku-4-5 é bem mais barato.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Porta em que o servidor local sobe.
PORT=3001
